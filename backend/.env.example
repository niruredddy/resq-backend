# Database
# Use your Supabase Postgres connection string here.
# Example format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# External API Keys
USGS_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1
GDACS_RSS_URL=https://www.gdacs.org/xml/rss.xml
NDMA_API_BASE=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
NASA_EARTHDATA_TOKEN=
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_AREA=68,6,98,36
NASA_FIRMS_SOURCE=VIIRS_NOAA21_NRT
NASA_FIRMS_DAYS=1
POPULATION_RASTER_PATH=
DEMAND_HISTORY_CSV=data/demand_history.sample.csv
SUPABASE_URL=https://your-project.supabase.co
# Optional for legacy HS256 Supabase projects. Leave empty for JWKS/ES256 verification.
SUPABASE_JWT_SECRET=
OSRM_BASE_URL=https://router.project-osrm.org

# App Config
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173
SCHEDULER_INTERVAL_MINUTES=15
ENABLE_SCHEDULED_INGESTION=true
